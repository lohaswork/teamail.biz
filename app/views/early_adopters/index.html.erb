<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "LohasWork" %></title>
    <meta name="keywords" content="乐活工场 团队协作 项目管理 SaaS">
    <meta name="description" content="乐活工场致力于打造出色的团队协作工具">
    <meta name="author" content="LohasWork">
    <%= stylesheet_link_tag "application", :media => "all" %>
    <!--[if lt IE 8]>
    <%= stylesheet_link_tag "font-awesome-ie7.min.css", media: "all" %>
    <![endif]-->
    <%= csrf_meta_tags %>
    <%= yield(:head) %>
  </head>
  <body>
    <div class="navbar navbar-fixed-top">
      <div class="nav-inner">
        <div class="container">
          <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse">
              <span class="sr-only">Toggle navigation</span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </button>
            <a href="#" class="nav-brand"><%= image_tag "logo-on-top.png" %></a>
          </div>
            <!-- Collect the nav links, forms, and other content for toggling -->
          <div class="collapse navbar-collapse navbar-ex1-collapse">
            <ul class="nav navbar-nav navbar-right">
              <li><a href="#">首页</a></li>
              <li><a href="#">博客</a></li>
              <li><a href="#">关于我们</a></li>
            </ul>
          </div><!-- /.navbar-collapse -->
        </div>
      </div>
    </div>
    <!-- End of navbar-->
    <!-- EarlyAdopters page layout -->
    <div class="hero-unit">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="vplayer">
              <%= video_player src: { mp4: 'videos/LohasWork-bestshow.mp4' },
                               controls: true,
                               width: "640",
                               height: "360",
                               preload: "auto"%>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- footer -->
    <div class="footer">
      <div class="container">
        <div class="row copyright">
          <div class="col-md-4">
            <a href="http://lohaswork.com" class="logo">
              <%= image_tag "logo-with-word-grey.png" %>
            </a>
            <p>
              Made by the team at <a href="http://lohaswork.com">LohasWork, Ltd</a>. Copyright 2013. <a href="http://lohaswork.com/terms-of-service">Terms of Service</a>
            </p>
          </div>
          <div class="col-md-4">
          </div>
          <div class="col-md-4">
            <h3>社交媒体</h3>
            <a href="#" class="social">
              <i class="icon-douban icon-2x"></i>
            </a>
            <a href="#" class="social">
              <i class="icon-weibo icon-2x"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
    <%= javascript_include_tag "application" %>
  </body>
</html>
